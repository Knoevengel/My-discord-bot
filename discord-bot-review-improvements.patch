+"""Regression tests for party ownership and placement rules."""
+
+from __future__ import annotations
+
+import os
+import tempfile
+import unittest
+
+import database
+
+
+class PartyDatabaseTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.temp_dir = tempfile.TemporaryDirectory()
+        self.old_db_path = database.DB_PATH
+        self.old_catalog_cache = database._catalog_cache
+        database.DB_PATH = os.path.join(self.temp_dir.name, "test-gacha.db")
+        database._catalog_cache = None
+        database.init_db()
+
+        database.get_or_create_user(1001, "Player One")
+        database.get_or_create_user(2002, "Player Two")
+
+        conn = database.get_connection()
+        try:
+            cursor = conn.execute(
+                """
+                INSERT INTO warrior_catalog
+                    (name, element, rarity, base_hp, base_atk, base_def, base_matk, base_mdef, base_speed)
+                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
+                """,
+                ("Test Hero", "Blaze", "Radiant", 100, 20, 10, 20, 10, 10),
+            )
+            self.warrior_id = cursor.lastrowid
+            conn.commit()
+        finally:
+            conn.close()
+
+        self.first_copy = database.add_warrior_to_user(1001, self.warrior_id)["instance_id"]
+        self.second_copy = database.add_warrior_to_user(1001, self.warrior_id)["instance_id"]
+        self.other_players_copy = database.add_warrior_to_user(2002, self.warrior_id)["instance_id"]
+
+    def tearDown(self) -> None:
+        database.DB_PATH = self.old_db_path
+        database._catalog_cache = self.old_catalog_cache
+        self.temp_dir.cleanup()
+
+    def test_get_user_warrior_returns_only_the_owners_copy(self) -> None:
+        warrior = database.get_user_warrior(1001, self.first_copy)
+        self.assertIsNotNone(warrior)
+        self.assertEqual(warrior["id"], self.first_copy)
+        self.assertIsNone(database.get_user_warrior(2002, self.first_copy))
+
+    def test_party_moves_an_instance_instead_of_cloning_it(self) -> None:
+        self.assertTrue(database.set_party_slot(1001, 1, self.first_copy))
+        self.assertTrue(database.set_party_slot(1001, 4, self.first_copy))
+        self.assertTrue(database.set_party_slot(1001, 2, self.second_copy))
+
+        party = database.get_party(1001)
+        self.assertEqual(set(party), {2, 4})
+        self.assertEqual(party[2]["user_warrior_id"], self.second_copy)
+        self.assertEqual(party[4]["user_warrior_id"], self.first_copy)
+
+    def test_party_rejects_another_players_instance(self) -> None:
+        self.assertTrue(database.set_party_slot(1001, 1, self.first_copy))
+        self.assertFalse(database.set_party_slot(1001, 2, self.other_players_copy))
+
+        party = database.get_party(1001)
+        self.assertEqual(set(party), {1})
+        self.assertEqual(party[1]["user_warrior_id"], self.first_copy)
+
+
+if __name__ == "__main__":
+    unittest.main()
