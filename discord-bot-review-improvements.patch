+    try:
+        cur = conn.cursor()
+        owned = cur.execute(
+            "SELECT 1 FROM user_warriors WHERE user_id = ? AND id = ?",
+            (user_id, user_warrior_id),
+        ).fetchone()
+        if not owned:
+            return False
+
+        # Moving an existing member should leave its old slot empty. This also
+        # cleans up any duplicate placements made by older versions of the bot.
