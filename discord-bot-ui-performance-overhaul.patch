@@ -0,0 +1,84 @@
+"""Regression tests for atomic summon persistence."""
+
+from __future__ import annotations
+
+import os
+import tempfile
+import unittest
+
+import database
+
+
+class PullBatchTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.temp_dir = tempfile.TemporaryDirectory()
+        self.old_db_path = database.DB_PATH
+        self.old_catalog_cache = database._catalog_cache
+        database.DB_PATH = os.path.join(self.temp_dir.name, "test-gacha.db")
+        database._catalog_cache = None
+        database.init_db()
+        database.get_or_create_user(3003, "Summoner")
+        database.update_user_field(3003, "summon_charms", 12)
+
+        conn = database.get_connection()
+        try:
+            self.hero_ids = []
+            for number, stars in enumerate((4, 5, 6), start=1):
+                cursor = conn.execute(
+                    """
+                    INSERT INTO warrior_catalog
+                        (name, element, rarity, stars, base_hp, base_atk, base_def, base_matk, base_mdef, base_speed)
+                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+                    """,
+                    (f"Hero {number}", "Blaze", "Test", stars, 100, 20, 10, 20, 10, 10),
+                )
+                self.hero_ids.append(cursor.lastrowid)
+            conn.commit()
+        finally:
+            conn.close()
+
+    def tearDown(self) -> None:
+        database.DB_PATH = self.old_db_path
+        database._catalog_cache = self.old_catalog_cache
+        self.temp_dir.cleanup()
+
+    def test_batch_updates_all_summon_state_in_one_operation(self) -> None:
+        result = database.apply_pull_batch(
+            3003,
+            expected_pity=0,
+            warrior_ids=[self.hero_ids[0], self.hero_ids[1], self.hero_ids[0]],
+            charm_cost=3,
+            new_pity=3,
+            progress_date="2026-09-29",
+        )
+
+        self.assertTrue(result["ok"])
+        self.assertEqual(len(result["outcomes"]), 3)
+        self.assertEqual(result["remaining_charms"], 9)
+        self.assertEqual(result["pity"], 3)
+        self.assertEqual(len(database.get_user_warriors(3003)), 3)
+
+        user = database.get_or_create_user(3003, "")
+        self.assertEqual(user["summon_charms"], 9)
+        self.assertEqual(user["pity_counter"], 3)
+        self.assertEqual(database.get_daily_progress(3003, "2026-09-29")["pull_total"], 3)
+
+    def test_state_change_rejects_the_batch_without_spending_resources(self) -> None:
+        database.update_user_field(3003, "pity_counter", 2)
+        result = database.apply_pull_batch(
+            3003,
+            expected_pity=0,
+            warrior_ids=[self.hero_ids[0]],
+            charm_cost=1,
+            new_pity=1,
+            progress_date="2026-09-29",
+        )
+
+        self.assertFalse(result["ok"])
+        self.assertEqual(result["reason"], "state_changed")
+        self.assertEqual(len(database.get_user_warriors(3003)), 0)
+        self.assertEqual(database.get_or_create_user(3003, "")["summon_charms"], 12)
+
+
+if __name__ == "__main__":
+    unittest.main()
