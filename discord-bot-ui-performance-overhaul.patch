+def apply_pull_batch(
+    user_id: int,
+    expected_pity: int,
+    warrior_ids: list[int],
+    charm_cost: int,
+    new_pity: int,
+    progress_date: str | None = None,
+):
+    """Apply a completed summon batch as one all-or-nothing SQLite transaction.
+
+    The caller rolls the random results first, then passes their catalog IDs
+    here.  This function deducts charms, creates all owned instances, updates
+    pity, and records pull-task progress in one commit.  A failed 10-pull can
+    therefore never charge a player for only some of its heroes.
+    """
+    warrior_ids = [int(warrior_id) for warrior_id in warrior_ids]
+    charm_cost = int(charm_cost)
+    expected_pity = int(expected_pity)
+    new_pity = int(new_pity)
+    if not warrior_ids or charm_cost != len(warrior_ids) or charm_cost <= 0:
+        return {"ok": False, "reason": "invalid_batch"}
+
+    conn = get_connection()
+    cur = conn.cursor()
+    try:
+        cur.execute("BEGIN IMMEDIATE")
+        user = cur.execute(
+            "SELECT summon_charms, pity_counter FROM users WHERE user_id = ?",
+            (user_id,),
+        ).fetchone()
+        if not user:
+            conn.rollback()
+            return {"ok": False, "reason": "missing_user"}
+        if int(user["summon_charms"]) < charm_cost:
+            conn.rollback()
+            return {
+                "ok": False,
+                "reason": "not_enough_charms",
+                "charms": int(user["summon_charms"]),
+            }
+        # A second click can arrive while the first pull is being resolved.
+        # Never apply random results generated from an out-of-date pity value.
+        if int(user["pity_counter"]) != expected_pity:
+            conn.rollback()
+            return {"ok": False, "reason": "state_changed"}
+
+        placeholders = ",".join("?" for _ in warrior_ids)
+        rows = cur.execute(
+            f"SELECT warrior_id, stars FROM warrior_catalog WHERE warrior_id IN ({placeholders})",
+            warrior_ids,
+        ).fetchall()
+        catalog_stars = {int(row["warrior_id"]): int(row["stars"]) for row in rows}
+        if len(catalog_stars) != len(set(warrior_ids)):
+            conn.rollback()
+            return {"ok": False, "reason": "missing_warrior"}
+
+        cur.execute(
+            "UPDATE users SET summon_charms = summon_charms - ?, pity_counter = ? WHERE user_id = ?",
+            (charm_cost, new_pity, user_id),
+        )
+        outcomes = []
+        for warrior_id in warrior_ids:
+            stars = catalog_stars[warrior_id]
+            cur.execute(
+                """INSERT INTO user_warriors
+                   (user_id, warrior_id, stars, base_stars, level, duplicate_copies)
+                   VALUES (?, ?, ?, ?, 1, 0)""",
+                (user_id, warrior_id, stars, stars),
+            )
+            outcomes.append({
+                "result": "new",
+                "instance_id": int(cur.lastrowid),
+                "stars": stars,
+                "base_stars": stars,
+            })
+
+        if progress_date:
+            cur.execute(
+                "INSERT INTO daily_progress (user_id, date, task_key, count) VALUES (?, ?, 'pull_total', ?) "
+                "ON CONFLICT(user_id, date, task_key) DO UPDATE SET count = count + excluded.count",
+                (user_id, progress_date, len(warrior_ids)),
+            )
+
+        conn.commit()
+        return {
+            "ok": True,
+            "outcomes": outcomes,
+            "remaining_charms": int(user["summon_charms"]) - charm_cost,
+            "pity": new_pity,
+        }
+    except Exception:
+        conn.rollback()
+        raise
+    finally:
+        conn.close()
